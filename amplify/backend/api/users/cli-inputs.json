{
  "version": 1,
  "paths": {
    "/get-user": {
      "name": "/get-user",
      "lambdaFunction": "getUser",
      "permissions": {
        "setting": "private",
        "auth": [
          "read"
        ]
      }
    },
    "/update-user": {
      "name": "/update-user",
      "lambdaFunction": "updateUser",
      "permissions": {
        "setting": "private",
        "auth": [
          "update"
        ]
      }
    }
  }
}